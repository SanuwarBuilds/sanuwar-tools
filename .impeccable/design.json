      "html": "<button class=\"ds-search-action\">Search</button>",
      "css": ".ds-search-action{font-family:Inter,sans-serif;background:var(--wb-accent,#3424bd);color:#fff;padding:8px 26px;min-height:44px;border:0;border-radius:9px;font-size:15px;font-weight:600;cursor:pointer}.ds-search-action:hover{filter:brightness(.96)}.ds-search-action:focus-visible{outline:2px solid var(--wb-accent,#3424bd);outline-offset:3px;}"
