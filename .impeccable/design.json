      "css": ".ds-tool-row{font-family:Inter,sans-serif;display:flex;flex-direction:column;gap:4px;min-height:64px;padding:10px 12px;border:1px solid var(--wb-line,#e0e1eb);border-radius:10px;background:var(--wb-card,#fff);color:var(--wb-ink,#111321);text-decoration:none}.ds-tool-row strong{font-size:16px;font-weight:650;line-height:1.2}.ds-tool-row small{font-size:12px;line-height:1.4;color:var(--wb-muted,#56596d)}.ds-tool-row:hover{border-color:var(--wb-line-strong,#c5c7d9);background:var(--wb-card-2,#fafaff)}.ds-tool-row:focus-visible{outline:2px solid var(--wb-accent,#3424bd);outline-offset:3px;}"
