      "css": ".ds-nav{display:flex;gap:8px;font-family:Inter,sans-serif;}.ds-nav a{display:flex;align-items:center;min-height:44px;padding:0 8px;font-size:14px;color:var(--wb-ink,#111321);text-decoration:none}.ds-nav a:hover{color:var(--wb-accent,#3424bd)}.ds-nav a:focus-visible{outline:2px solid var(--wb-accent,#3424bd);outline-offset:3px;}"
