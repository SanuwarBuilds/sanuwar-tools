      "kind": "input",
      "refersTo": "search-field",
      "description": "Compound search styling; preview shows the text field.",
      "html": "<input class=\"ds-search-field\" type=\"search\" aria-label=\"Search everything\" placeholder=\"Search tools, files, downloads and more\u2026\">",
      "css": ".ds-search-field{font-family:Inter,sans-serif;width:100%;min-height:58px;padding:6px 16px;border:1px solid #9b9dbc;border-radius:12px;background:var(--wb-card,#fff);color:var(--wb-ink,#111321);font-size:16px}.ds-search-field:hover{border-color:var(--wb-line-strong,#c5c7d9)}.ds-search-field:focus-visible{outline:2px solid var(--wb-accent-wash,#eeebff);border-color:var(--wb-accent,#3424bd);outline-offset:0}"
    },
