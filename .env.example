# Copy to .env for LOCAL development. Set these directly in your host for deployment.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_USER=
# Generate with the interactive command in README.md. A Werkzeug hash is preferred.
ADMIN_PASSWORD_HASH=
# Alternative: at least 12 characters. Never use both password settings.
ADMIN_PASSWORD=
# Required on HTTPS hosts outside Vercel; automatic on Vercel.
COOKIE_SECURE=0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for durable admin writes on Vercel. Use a fine-grained token limited
# to this repository with Contents read/write. Never send this token to a browser.
GITHUB_PAT=
GITHUB_USER=SanuwarBuilds
GITHUB_REPO=sanuwar-tools

# Public AdSense publisher ID (not a secret). Ads load only on HTTPS
# sanuwartools.online public tool/download pages. Set 0 for an emergency pause.
ADSENSE_CLIENT=ca-pub-8814284684394847
ADSENSE_ENABLED=1

# Public Google OAuth WEB client ID. No client secret is needed for GIS sign-in.
# Register https://sanuwartools.online as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
